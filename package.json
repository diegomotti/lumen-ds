{
    "name": "lumen-ds",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
        "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify --watch",
        "build": "npm run build:css && node build.js",
        "start": "node server.js",
        "dev": "concurrently --kill-others-on-fail \"npm:start\" \"npm:watch:css\""
    },
    "devDependencies": {
        "@tailwindcss/cli": "latest",
        "concurrently": "latest",
        "tailwindcss": "latest"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true
    }
}
